{
  "name": "@tetherto/mdk-app-operation-center",
  "version": "0.13.0",
  "private": true,
  "description": "Operation Center: a single-site operations app for MDK (Gateway plugin + dashboard UI).",
  "keywords": [
    "mdk",
    "mdk-app"
  ],
  "license": "Apache-2.0",
  "files": [
    "mdk-app.yaml",
    "plugin/",
    "ui/",
    "README.md"
  ],
  "scripts": {
    "setup": "sh scripts/setup.sh",
    "mdk": "mdk",
    "build:ui": "npm --prefix ui-src run build",
    "dev:ui": "npm --prefix ui-src run dev",
    "dev:stack": "npm run mdk -- run --dir dev",
    "dev:stack:mock": "npm run mdk -- run --dir dev/mock-site",
    "dev:dashboard": "npm run mdk -- run dashboard --dir dev",
    "validate": "npm run mdk -- validate app op-centre-lite --dir dev",
    "e2e": "sh scripts/e2e.sh",
    "typecheck": "npm --prefix ui-src run typecheck",
    "lint": "OXLINT_TSGOLINT_PATH=ui-src/node_modules/.bin/tsgolint ui-src/node_modules/.bin/oxlint --type-aware --report-unused-disable-directives -c .oxlintrc.json .",
    "lint:fix": "OXLINT_TSGOLINT_PATH=ui-src/node_modules/.bin/tsgolint ui-src/node_modules/.bin/oxlint --type-aware --fix -c .oxlintrc.json .",
    "fmt": "ui-src/node_modules/.bin/oxfmt -c .oxfmtrc.json .",
    "fmt:check": "ui-src/node_modules/.bin/oxfmt -c .oxfmtrc.json --check .",
    "test": "npm --prefix ui-src run test",
    "test:coverage": "npm --prefix ui-src run test:coverage",
    "check": "npm run fmt:check && npm run lint && npm run typecheck && npm run test && npm --prefix ui-src run gen:routes:check && npm run build:ui && npm run validate",
    "gen:routes": "npm --prefix ui-src run gen:routes"
  },
  "devDependencies": {
    "@tetherto/mdk-app-runtime": "0.13.0",
    "@tetherto/mdk-cli": "0.13.0"
  },
  "engines": {
    "node": ">=24"
  }
}
