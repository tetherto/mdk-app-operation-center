{
  "info": {
    "_postman_id": "5f24105a-ae95-4199-aa75-067f2b841a39",
    "name": "Operation Center Lite",
    "description": "Every route of the Operation Center Lite MDK app, through the Gateway. Set `gatewayUrl`, `username` and `password` in the collection variables, run '0. Sign in / Login' once (it stores the token), then any request. Bodies are typed in ui-src/api/contract.ts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Sign in",
      "description": "Run first. Every app route needs a Bearer token; this stores it in the collection variable `accessToken` for the other requests.",
      "item": [
        {
          "name": "Login (stores accessToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/auth/login",
              "host": ["{{gatewayUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Signs in at the Gateway with a user from `mdk user add`. The test script saves `accessToken` for every other request.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed in', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "if (body.refreshToken) pm.collectionVariables.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/auth/me",
              "host": ["{{gatewayUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "The signed-in user and roles, as the Gateway sees the token.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/auth/refresh",
              "host": ["{{gatewayUrl}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Exchanges the refresh token for a new access token.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('refreshed', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json(); if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
