    {
      "name": "4. Commands",
      "description": "Write routes. Sent to each target miner's worker as the signed-in operator. `accepted` is whether the Kernel queued at least one command, `minerCount` how many. A target that matches no miners returns `accepted: false`. 403 `ERR_COMMANDS_DISABLED` when `commandsEnabled` is false.",
      "item": [
        {
          "name": "Power mode for a container",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/apps/{{appMount}}/api/commands/power-mode",
              "host": ["{{gatewayUrl}}"],
              "path": ["apps", "{{appMount}}", "api", "commands", "power-mode"]
            },
            "description": "Modes: sleep, low, normal, high. Miners whose worker does not support the mode are skipped. Offline miners are skipped.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"target\": {\n    \"containerId\": \"{{containerId}}\"\n  },\n  \"mode\": \"low\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('accepted', () => pm.expect(pm.response.json().accepted).to.be.true);"
                ]
              }
            }
          ],
          "response": []
        },
